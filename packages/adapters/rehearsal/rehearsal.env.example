# Copy this file to ~/.hookemon/rehearsal.env, replace every angle-bracket value, then source it
# from the repository root. It contains no secret material.

# Owner-supplied values.
export HOOKEMON_COLLECTOR_CRYPT_API_KEY_PATH="<absolute-path-to-private-collector-key-file>"
export HOOKEMON_PACK_CODE="<selected-collector-pack-code>"
export HOOKEMON_REHEARSAL_PROCEEDS_ACCOUNT="<operations-owned-solana-settlement-token-account>"
export HOOKEMON_REHEARSAL_PAYOUT_RECIPIENTS="<recipient-one>,<recipient-two>"
export HOOKEMON_STATE_DIR="<absolute-path-to-dedicated-rehearsal-state-directory>"
export HOOKEMON_DASHBOARD_PROXY_CREDENTIAL="<dashboard-proxy-credential>"

# Bounded live Collector-only profile.
export HOOKEMON_REHEARSAL_MODE=collector-only
export HOOKEMON_PROVIDER_MODE=live
export HOOKEMON_CHAIN_ID=4663
export HOOKEMON_SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
export HOOKEMON_COLLECTOR_CRYPT_BASE_URL=https://gacha.collectorcrypt.com
export HOOKEMON_SOLANA_ACCOUNT=BrvhPB9EeAukw8g3jibQDFBYY5abu3Vchdm9ri3PHZNE
export HOOKEMON_SIGNER_BACKEND=keychain
export HOOKEMON_SIGNER_LIVE_MODE=true
export HOOKEMON_KEYCHAIN_COMMAND="$(pwd)/packages/adapters/bin/hookemon-keychain-signer.mjs"
export HOOKEMON_KEYCHAIN_SOLANA_ACCOUNT=operator-solana
export HOOKEMON_REHEARSAL_PAYOUT_SPLIT=equal
export HOOKEMON_DASHBOARD_PROFILE=mainnet
export HOOKEMON_DASHBOARD_PORT=8787

# Typed configuration. Preflight verifies the selected pack costs 25000000 atomic units and
# refuses a balance that cannot satisfy the configured fee reserve.
export HOOKEMON_BUDGET_AVAILABLE_PROCESS_USDG=25000000
export HOOKEMON_BUDGET_PACK_PRICE_USDG=25000000
export HOOKEMON_BUDGET_OUTBOUND_CAP_USDG=0
export HOOKEMON_BUDGET_RETURN_CAP_USDG=0
export HOOKEMON_BUDGET_OPERATING_MARGIN_USDG=0
export HOOKEMON_MIN_ROBINHOOD_RECEIVE=0
export HOOKEMON_MIN_SOLANA_RECEIVE=0
export HOOKEMON_MIN_RETURN_USDG=0
export HOOKEMON_NATIVE_GAS_CAP_ROBINHOOD=0
export HOOKEMON_NATIVE_GAS_CAP_SOLANA=0
export HOOKEMON_EVM_GAS_PRICE_CAP=2000000000
export HOOKEMON_EVM_NATIVE_RESERVE=3000000000000000
export HOOKEMON_SOLANA_PRIORITY_FEE_CAP=25000
export HOOKEMON_SOLANA_LAMPORT_RESERVE=5000000
