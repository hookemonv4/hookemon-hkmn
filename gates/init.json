    {
      "id": "RZ-I1",
      "excuse": "The idea is clear enough from the owner's message",
      "reality": "If you cannot write the owner's desired outcome in one falsifiable sentence, it is not clear. Interview first."
    },
    {
      "id": "RZ-I2",
      "excuse": "We can pin dependencies later",
      "reality": "Every later phase binds evidence to hashes. Unpinned inputs make all of it unverifiable."
    }
  ]
