          "properties": {
            "manager": {
              "$ref": "#/$defs/nonzeroAddress"
            },
            "tokenId": {
              "const": 0
            }
          }
        },
        "initializerCalldata": {
          "type": "null"
        },
        "deploymentValue": {
          "$ref": "#/$defs/nativeValue"
        },
        "initializerValue": {
          "$ref": "#/$defs/nativeValue"
        },
        "creationBytecodeHash": {
          "$ref": "#/$defs/bytes32"
        },
        "runtimeTemplateCodeHash": {
          "$ref": "#/$defs/bytes32"
        },
        "runtimeCodeHash": {
          "type": "null"
        },
        "artifactSha256": {
          "$ref": "#/$defs/sha256"
        },
        "libraries": {
          "type": "array",
          "maxItems": 0
        }
      }
    },
    "hookTarget": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "targetId",
        "targetIndex",
        "componentKind",
        "sourcePath",
        "contractName",
        "applicantSalt",
        "effectiveSalt",
        "address",
        "declaredHookPermissions",
        "permissionMask",
        "constructor",
        "initializer",
        "deploymentValue",
        "initializerValue",
        "creationBytecodeHash",
        "runtimeTemplateCodeHash",
        "runtimeCodeHash",
        "artifactSha256",
        "libraries"
      ],
      "properties": {
        "targetId": {
          "const": "hook"
        },
        "targetIndex": {
          "const": 2
        },
        "componentKind": {
          "const": "hook"
        },
        "sourcePath": {
          "const": "packages/contracts/src/HookemonHook.sol"
        },
        "contractName": {
          "const": "HookemonHook"
        },
        "applicantSalt": {
          "type": "null"
        },
        "effectiveSalt": {
          "type": "null"
        },
        "address": {
          "type": "null"
        },
        "declaredHookPermissions": {
          "const": [
            "beforeInitialize",
