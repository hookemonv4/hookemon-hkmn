            "manager": {
              "$ref": "#/$defs/nonzeroAddress"
            },
            "positionManager": {
              "$ref": "#/$defs/nonzeroAddress"
            },
            "permit2": {
              "$ref": "#/$defs/nonzeroAddress"
            },
            "usdg": {
              "$ref": "#/$defs/nonzeroAddress"
            },
            "hkmn": {
              "type": "null"
            },
            "tickSpacing": {
              "const": 60
            },
            "programmable": {
              "$ref": "#/$defs/nonzeroAddress"
            },
            "treasury": {
              "$ref": "#/$defs/nonzeroAddress"
            },
            "operations": {
              "$ref": "#/$defs/nonzeroAddress"
            },
            "launchAuthority": {
              "$ref": "#/$defs/nonzeroAddress"
            },
            "issuanceAuthority": {
              "$ref": "#/$defs/nonzeroAddress"
            },
            "expectedDecimals": {
              "const": 18
            },
            "bindingDigest": {
              "type": "null"
            },
            "runtimeDigest": {
              "type": "null"
            },
            "seedIntentDigest": {
              "type": "null"
            },
            "processClaimLimit6h": {
              "type": "string",
              "pattern": "^(0|[1-9][0-9]*)$"
            },
            "processClaimLimitMax": {
              "type": "string",
              "pattern": "^(0|[1-9][0-9]*)$"
            },
            "processClaimMaxCount": {
              "const": 24
            },
            "operationsRotationDelay": {
              "type": "string",
              "pattern": "^(0|[1-9][0-9]*)$"
            }
          }
        },
        "initializer": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "function",
            "sqrtPriceX96",
            "calldata"
          ],
          "properties": {
            "function": {
              "const": "initializeGraphLaunch(address,uint160)"
            },
            "sqrtPriceX96": {
              "type": "null"
            },
            "calldata": {
              "type": "null"
            }
          }
        },
        "deploymentValue": {
          "$ref": "#/$defs/nativeValue"
        },
        "initializerValue": {
          "$ref": "#/$defs/nativeValue"
        },
        "creationBytecodeHash": {
          "$ref": "#/$defs/bytes32"
        },
        "runtimeTemplateCodeHash": {
          "$ref": "#/$defs/bytes32"
        },
        "runtimeCodeHash": {
          "type": "null"
        },
        "artifactSha256": {
          "$ref": "#/$defs/sha256"
        },
        "libraries": {
          "type": "array",
          "maxItems": 0
        }
      }
    },
    "nativeValue": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "chainId",
        "assetId",
        "decimals",
        "amountAtomic"
      ],
      "properties": {
        "chainId": {
          "const": "4663"
        },
        "assetId": {
          "const": "native"
        },
        "decimals": {
          "const": 18
        },
        "amountAtomic": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]*)$"
        }
      }
    },
    "graphCall": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "callId",
        "targetId",
        "function",
        "selector",
        "caller",
        "argumentBindings",
        "calldata",
        "reason"
      ],
      "properties": {
        "callId": {
          "type": "string",
          "minLength": 1
        },
        "targetId": {
          "enum": [
            "token",
            "hook",
            "custody"
          ]
        },
        "function": {
          "type": "string",
          "minLength": 1
        },
        "selector": {
          "type": "string",
          "pattern": "^0x[0-9a-f]{8}$"
        },
        "caller": {
          "type": "string",
          "minLength": 1
        },
        "argumentBindings": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "calldata": {
          "type": "null"
        },
        "reason": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "historicalDraft": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "status",
        "launchInputsPath",
        "deployer",
        "compiler",
        "targets",
        "pool",
        "requiredGraphCalls",
        "postDeployAssertions",
        "openFacts"
      ],
      "properties": {
        "schemaVersion": {
          "const": "hookemon.phase3.address-manifest-draft.v1"
        },
        "status": {
          "const": "ADDRESS_DERIVATION_PENDING"
        },
        "launchInputsPath": {
          "const": "release/phase3/launch-inputs.json"
        },
        "deployer": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "factory",
            "entrypoint",
            "router",
            "routeNamespace",
            "routeNonce",
            "topologyHash"
          ],
          "properties": {
            "factory": {
              "$ref": "#/$defs/nonzeroAddress"
            },
            "entrypoint": {
              "const": "launchAndStampV1"
            },
            "router": {
              "$ref": "#/$defs/nonzeroAddress"
            },
            "routeNamespace": {
              "$ref": "#/$defs/nullableBytes32"
            },
            "routeNonce": {
              "$ref": "#/$defs/nullableBytes32"
            },
            "topologyHash": {
              "$ref": "#/$defs/nullableBytes32"
            }
          }
        },
        "compiler": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "solc",
            "solcLongVersion",
            "standardJson",
            "buildInfo"
          ],
          "properties": {
            "solc": {
              "const": "0.8.26+commit.8a97fa7a"
            },
            "solcLongVersion": {
              "const": "0.8.26+commit.8a97fa7a"
            },
            "standardJson": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "optimizer",
                "viaIR",
                "evmVersion",
                "metadata"
              ],
              "properties": {
                "optimizer": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "enabled",
                    "runs"
                  ],
                  "properties": {
                    "enabled": {
                      "const": true
                    },
                    "runs": {
                      "const": 1000
                    }
                  }
                },
                "viaIR": {
                  "const": false
                },
                "evmVersion": {
                  "const": "cancun"
                },
                "metadata": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "appendCBOR",
                    "bytecodeHash",
                    "useLiteralContent"
                  ],
                  "properties": {
                    "appendCBOR": {
                      "const": false
                    },
                    "bytecodeHash": {
                      "const": "none"
                    },
                    "useLiteralContent": {
                      "const": false
                    }
                  }
                }
              }
            },
            "buildInfo": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "status",
                "localBuildInfoCount",
                "sourceCount",
                "sourceContentSha256",
                "reason"
              ],
              "properties": {
                "status": {
                  "const": "OPEN_FACT"
                },
                "localBuildInfoCount": {
                  "const": 1
                },
                "sourceCount": {
                  "type": "integer",
                  "minimum": 1
                },
                "sourceContentSha256": {
                  "$ref": "#/$defs/sha256"
                },
                "reason": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          }
        },
        "targets": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "prefixItems": [
            {
              "$ref": "#/$defs/tokenTarget"
            },
            {
              "$ref": "#/$defs/custodyTarget"
            },
            {
              "$ref": "#/$defs/hookTarget"
            }
          ],
          "items": false
        },
        "pool": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "fee",
            "tickSpacing",
            "currency0",
            "currency1",
            "poolKey",
            "poolId"
          ],
          "properties": {
            "fee": {
              "const": 0
            },
            "tickSpacing": {
              "const": 60
            },
            "currency0": {
              "$ref": "#/$defs/nullableAddress"
            },
            "currency1": {
              "$ref": "#/$defs/nullableAddress"
            },
            "poolKey": {
              "type": "null"
            },
            "poolId": {
              "$ref": "#/$defs/nullableBytes32"
            }
          }
        },
        "requiredGraphCalls": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "prefixItems": [
            {
              "properties": {
                "callId": {
                  "const": "token-allocate"
                },
                "targetId": {
                  "const": "token"
                },
                "function": {
                  "const": "allocate(address)"
                },
                "selector": {
                  "const": "0xffd7d983"
                }
              }
            },
            {
              "properties": {
                "callId": {
                  "const": "custody-bind-hook"
                },
                "targetId": {
                  "const": "custody"
                },
                "function": {
                  "const": "configureBindingHook(address)"
                },
                "selector": {
                  "const": "0xc81cbd43"
                }
              }
            },
            {
              "properties": {
                "callId": {
                  "const": "hook-initialize-graph-launch"
                },
                "targetId": {
                  "const": "hook"
                },
                "function": {
                  "const": "initializeGraphLaunch(address,uint160)"
                },
                "selector": {
                  "const": "0x726bb4ae"
                }
              }
            }
          ],
          "items": {
            "$ref": "#/$defs/graphCall"
          }
        },
        "postDeployAssertions": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "openFacts": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "nativeSharednonzeroAddress": {
      "allOf": [
        {
          "$ref": "#/$defs/nativeSharedaddress"
