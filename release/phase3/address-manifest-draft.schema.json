            },
            "calldata": {
              "const": null
            },
            "reason": {
              "const": "The custody binds the resolved hook before the launch graph is initialized."
            }
          }
        },
        {
          "allOf": [
            {
              "$ref": "#/$defs/nativeShareddraftGraphCall"
            }
          ],
          "properties": {
            "callId": {
              "const": "hook-initialize-graph-launch"
