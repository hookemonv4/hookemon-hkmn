            "manager",
            "positionManager",
            "permit2",
            "usdg",
            "hkmn",
            "tickSpacing",
            "programmable",
            "treasury",
            "operations",
            "launchAuthority",
            "issuanceAuthority",
            "expectedDecimals",
            "bindingDigest",
            "runtimeDigest",
            "seedIntentDigest",
            "processClaimLimit6h",
            "processClaimLimitMax",
            "processClaimMaxCount",
            "operationsRotationDelay"
