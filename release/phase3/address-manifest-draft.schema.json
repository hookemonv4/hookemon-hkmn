    "nativeShareddraftGraphCalls": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "prefixItems": [
        {
          "allOf": [
            {
              "$ref": "#/$defs/nativeShareddraftGraphCall"
            }
          ],
          "properties": {
            "callId": {
              "const": "token-allocate"
            },
            "targetId": {
              "const": "token"
            },
            "function": {
              "const": "allocate(address)"
            },
            "selector": {
              "const": "0xffd7d983"
            },
            "caller": {
              "const": "graph factory"
            },
            "argumentBindings": {
              "const": [
                "resolved HookemonHook address"
              ]
            },
            "calldata": {
              "const": null
            },
            "reason": {
              "const": "The graph factory allocates the fixed supply after all target addresses are resolved."
            }
          }
        },
        {
          "allOf": [
            {
              "$ref": "#/$defs/nativeShareddraftGraphCall"
