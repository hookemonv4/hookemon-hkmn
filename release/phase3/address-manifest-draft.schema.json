{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hookemon.example/schemas/phase3-address-manifest-draft-v1.json",
  "title": "Hookemon Phase 3 address-derivation draft manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "status",
    "launchInputsPath",
    "deployer",
    "compiler",
    "targets",
    "pool",
    "requiredGraphCalls",
    "postDeployAssertions",
    "openFacts"
  ],
  "properties": {
    "schemaVersion": { "const": "hookemon.phase3.address-manifest-draft.v1" },
    "status": { "const": "ADDRESS_DERIVATION_PENDING" },
    "launchInputsPath": { "const": "release/phase3/launch-inputs.json" },
    "deployer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["factory", "entrypoint", "router", "routeNamespace", "routeNonce", "topologyHash"],
      "properties": {
        "factory": { "$ref": "#/$defs/nonzeroAddress" },
        "entrypoint": { "const": "launchAndStampV1" },
        "router": { "$ref": "#/$defs/nonzeroAddress" },
        "routeNamespace": { "$ref": "#/$defs/nullableBytes32" },
        "routeNonce": { "$ref": "#/$defs/nullableBytes32" },
        "topologyHash": { "$ref": "#/$defs/nullableBytes32" }
      }
    },
    "compiler": {
      "type": "object",
      "additionalProperties": false,
      "required": ["solc", "solcLongVersion", "standardJson", "buildInfo"],
      "properties": {
        "solc": { "const": "0.8.26+commit.8a97fa7a" },
        "solcLongVersion": { "const": "0.8.26+commit.8a97fa7a" },
        "standardJson": {
          "type": "object",
          "additionalProperties": false,
          "required": ["optimizer", "viaIR", "evmVersion", "metadata"],
          "properties": {
            "optimizer": {
              "type": "object",
              "additionalProperties": false,
              "required": ["enabled", "runs"],
              "properties": { "enabled": { "const": true }, "runs": { "const": 1000 } }
            },
            "viaIR": { "const": false },
            "evmVersion": { "const": "cancun" },
            "metadata": {
              "type": "object",
              "additionalProperties": false,
              "required": ["appendCBOR", "bytecodeHash", "useLiteralContent"],
              "properties": {
                "appendCBOR": { "const": false },
                "bytecodeHash": { "const": "none" },
                "useLiteralContent": { "const": false }
              }
            }
          }
        },
        "buildInfo": {
          "type": "object",
          "additionalProperties": false,
          "required": ["status", "localBuildInfoCount", "sourceCount", "sourceContentSha256", "reason"],
          "properties": {
            "status": { "const": "OPEN_FACT" },
            "localBuildInfoCount": { "const": 1 },
            "sourceCount": { "type": "integer", "minimum": 1 },
            "sourceContentSha256": { "$ref": "#/$defs/sha256" },
            "reason": { "type": "string", "minLength": 1 }
          }
        }
      }
    },
    "targets": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "prefixItems": [
        { "$ref": "#/$defs/tokenTarget" },
        { "$ref": "#/$defs/custodyTarget" },
        { "$ref": "#/$defs/hookTarget" }
      ],
      "items": false
    },
    "pool": {
      "type": "object",
      "additionalProperties": false,
      "required": ["fee", "tickSpacing", "currency0", "currency1", "poolKey", "poolId"],
      "properties": {
        "fee": { "const": 0 },
        "tickSpacing": { "const": 60 },
        "currency0": { "$ref": "#/$defs/nullableAddress" },
        "currency1": { "$ref": "#/$defs/nullableAddress" },
        "poolKey": { "type": "null" },
        "poolId": { "$ref": "#/$defs/nullableBytes32" }
      }
    },
    "requiredGraphCalls": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "prefixItems": [
        {
          "properties": {
            "callId": { "const": "token-allocate" },
            "targetId": { "const": "token" },
            "function": { "const": "allocate(address)" },
            "selector": { "const": "0xffd7d983" }
          }
        },
        {
          "properties": {
            "callId": { "const": "custody-bind-hook" },
            "targetId": { "const": "custody" },
            "function": { "const": "configureBindingHook(address)" },
            "selector": { "const": "0xc81cbd43" }
          }
        },
        {
          "properties": {
            "callId": { "const": "hook-initialize-graph-launch" },
            "targetId": { "const": "hook" },
            "function": { "const": "initializeGraphLaunch(address,uint160)" },
            "selector": { "const": "0x726bb4ae" }
          }
        }
      ],
      "items": { "$ref": "#/$defs/graphCall" }
    },
    "postDeployAssertions": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
    "openFacts": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } }
  },
  "$defs": {
    "address": { "type": "string", "pattern": "^0x[0-9a-fA-F]{40}$" },
    "nonzeroAddress": {
      "allOf": [
        { "$ref": "#/$defs/address" },
        { "not": { "const": "0x0000000000000000000000000000000000000000" } }
      ]
    },
    "nullableAddress": { "type": ["null", "string"], "pattern": "^0x[0-9a-fA-F]{40}$" },
    "bytes32": { "type": "string", "pattern": "^0x[0-9a-fA-F]{64}$" },
    "nullableBytes32": { "type": ["null", "string"], "pattern": "^0x[0-9a-fA-F]{64}$" },
    "sha256": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "applicantSalt": { "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/bytes32" }] },
    "tokenTarget": {
      "type": "object",
      "additionalProperties": false,
      "required": ["targetId", "targetIndex", "componentKind", "sourcePath", "contractName", "applicantSalt", "effectiveSalt", "address", "constructor", "initializerCalldata", "deploymentValue", "initializerValue", "creationBytecodeHash", "runtimeTemplateCodeHash", "runtimeCodeHash", "artifactSha256", "libraries"],
      "properties": {
        "targetId": { "const": "token" },
        "targetIndex": { "const": 0 },
        "componentKind": { "const": "token" },
        "sourcePath": { "const": "packages/contracts/src/launch/HKMNToken.sol" },
        "contractName": { "const": "HKMNToken" },
        "applicantSalt": { "type": "null" },
        "effectiveSalt": { "type": "null" },
        "address": { "type": "null" },
        "constructor": {
          "type": "object",
          "additionalProperties": false,
          "required": ["issuanceAuthority", "expectedUsdg", "decimals", "launchSqrtPriceX96"],
          "properties": {
            "issuanceAuthority": { "$ref": "#/$defs/nonzeroAddress" },
            "expectedUsdg": { "$ref": "#/$defs/nonzeroAddress" },
            "decimals": { "const": 18 },
            "launchSqrtPriceX96": { "type": "null" }
          }
        },
        "initializerCalldata": { "type": "null" },
        "deploymentValue": { "$ref": "#/$defs/nativeValue" },
        "initializerValue": { "$ref": "#/$defs/nativeValue" },
        "creationBytecodeHash": { "$ref": "#/$defs/bytes32" },
        "runtimeTemplateCodeHash": { "$ref": "#/$defs/bytes32" },
        "runtimeCodeHash": { "type": "null" },
        "artifactSha256": { "$ref": "#/$defs/sha256" },
        "libraries": { "type": "array", "maxItems": 0 }
      }
    },
    "custodyTarget": {
      "type": "object",
      "additionalProperties": false,
      "required": ["targetId", "targetIndex", "componentKind", "sourcePath", "contractName", "applicantSalt", "effectiveSalt", "address", "constructor", "initializerCalldata", "deploymentValue", "initializerValue", "creationBytecodeHash", "runtimeTemplateCodeHash", "runtimeCodeHash", "artifactSha256", "libraries"],
      "properties": {
        "targetId": { "const": "custody" },
        "targetIndex": { "const": 1 },
        "componentKind": { "const": "other" },
        "sourcePath": { "const": "packages/contracts/src/bindings/RobinhoodBindings.sol" },
        "contractName": { "const": "PermanentPositionCustody" },
        "applicantSalt": { "type": "null" },
        "effectiveSalt": { "type": "null" },
        "address": { "type": "null" },
        "constructor": {
          "type": "object",
          "additionalProperties": false,
          "required": ["manager", "tokenId"],
          "properties": {
            "manager": { "$ref": "#/$defs/nonzeroAddress" },
            "tokenId": { "const": 0 }
          }
        },
        "initializerCalldata": { "type": "null" },
        "deploymentValue": { "$ref": "#/$defs/nativeValue" },
        "initializerValue": { "$ref": "#/$defs/nativeValue" },
        "creationBytecodeHash": { "$ref": "#/$defs/bytes32" },
        "runtimeTemplateCodeHash": { "$ref": "#/$defs/bytes32" },
        "runtimeCodeHash": { "type": "null" },
        "artifactSha256": { "$ref": "#/$defs/sha256" },
        "libraries": { "type": "array", "maxItems": 0 }
      }
    },
    "hookTarget": {
      "type": "object",
      "additionalProperties": false,
      "required": ["targetId", "targetIndex", "componentKind", "sourcePath", "contractName", "applicantSalt", "effectiveSalt", "address", "declaredHookPermissions", "permissionMask", "constructor", "initializer", "deploymentValue", "initializerValue", "creationBytecodeHash", "runtimeTemplateCodeHash", "runtimeCodeHash", "artifactSha256", "libraries"],
      "properties": {
        "targetId": { "const": "hook" },
        "targetIndex": { "const": 2 },
        "componentKind": { "const": "hook" },
        "sourcePath": { "const": "packages/contracts/src/HookemonHook.sol" },
        "contractName": { "const": "HookemonHook" },
        "applicantSalt": { "type": "null" },
        "effectiveSalt": { "type": "null" },
        "address": { "type": "null" },
        "declaredHookPermissions": { "const": ["beforeInitialize", "beforeSwap", "beforeSwapReturnDelta", "afterSwap", "afterSwapReturnDelta"] },
        "permissionMask": { "const": "0x20cc" },
        "constructor": {
          "type": "object",
          "additionalProperties": false,
          "required": ["manager", "positionManager", "permit2", "usdg", "hkmn", "tickSpacing", "programmable", "treasury", "operations", "launchAuthority", "issuanceAuthority", "expectedDecimals", "bindingDigest", "runtimeDigest", "processClaimLimit6h", "processClaimLimitMax", "processClaimMaxCount", "operationsRotationDelay"],
          "properties": {
            "manager": { "$ref": "#/$defs/nonzeroAddress" },
            "positionManager": { "$ref": "#/$defs/nonzeroAddress" },
            "permit2": { "$ref": "#/$defs/nonzeroAddress" },
            "usdg": { "$ref": "#/$defs/nonzeroAddress" },
            "hkmn": { "type": "null" },
            "tickSpacing": { "const": 60 },
            "programmable": { "$ref": "#/$defs/nonzeroAddress" },
            "treasury": { "$ref": "#/$defs/nonzeroAddress" },
            "operations": { "$ref": "#/$defs/nonzeroAddress" },
            "launchAuthority": { "$ref": "#/$defs/nonzeroAddress" },
            "issuanceAuthority": { "$ref": "#/$defs/nonzeroAddress" },
            "expectedDecimals": { "const": 18 },
            "bindingDigest": { "type": "null" },
            "runtimeDigest": { "type": "null" },
            "processClaimLimit6h": { "type": "string", "pattern": "^(0|[1-9][0-9]*)$" },
            "processClaimLimitMax": { "type": "string", "pattern": "^(0|[1-9][0-9]*)$" },
            "processClaimMaxCount": { "const": 24 },
            "operationsRotationDelay": { "type": "string", "pattern": "^(0|[1-9][0-9]*)$" }
          }
        },
        "initializer": {
          "type": "object",
          "additionalProperties": false,
          "required": ["function", "sqrtPriceX96", "calldata"],
          "properties": {
            "function": { "const": "initializeGraphLaunch(address,uint160)" },
            "sqrtPriceX96": { "type": "null" },
            "calldata": { "type": "null" }
          }
        },
        "deploymentValue": { "$ref": "#/$defs/nativeValue" },
        "initializerValue": { "$ref": "#/$defs/nativeValue" },
        "creationBytecodeHash": { "$ref": "#/$defs/bytes32" },
        "runtimeTemplateCodeHash": { "$ref": "#/$defs/bytes32" },
        "runtimeCodeHash": { "type": "null" },
        "artifactSha256": { "$ref": "#/$defs/sha256" },
        "libraries": { "type": "array", "maxItems": 0 }
      }
    },
    "nativeValue": {
      "type": "object",
      "additionalProperties": false,
      "required": ["chainId", "assetId", "decimals", "amountAtomic"],
      "properties": {
        "chainId": { "const": "4663" },
        "assetId": { "const": "native" },
        "decimals": { "const": 18 },
        "amountAtomic": { "type": "string", "pattern": "^(0|[1-9][0-9]*)$" }
      }
    },
    "graphCall": {
      "type": "object",
      "additionalProperties": false,
      "required": ["callId", "targetId", "function", "selector", "caller", "argumentBindings", "calldata", "reason"],
      "properties": {
        "callId": { "type": "string", "minLength": 1 },
        "targetId": { "enum": ["token", "hook", "custody"] },
        "function": { "type": "string", "minLength": 1 },
        "selector": { "type": "string", "pattern": "^0x[0-9a-f]{8}$" },
        "caller": { "type": "string", "minLength": 1 },
        "argumentBindings": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "calldata": { "type": "null" },
        "reason": { "type": "string", "minLength": 1 }
      }
    }
  }
}
