        "deploymentValue": {
          "$ref": "#/$defs/nativeSharednativeValue"
        },
        "initializerValue": {
          "$ref": "#/$defs/nativeSharednativeValue"
        },
        "creationBytecodeHash": {
          "$ref": "#/$defs/nativeSharednonzeroBytes32"
        },
        "runtimeTemplateCodeHash": {
          "$ref": "#/$defs/nativeSharednonzeroBytes32"
        },
        "runtimeCodeHash": {
          "type": "null"
        },
        "artifactSha256": {
          "$ref": "#/$defs/nativeShareddigest"
        },
        "libraries": {
          "type": "array",
