{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hookemon.example/schemas/phase3-address-manifest-draft-v1.json",
  "title": "Hookemon Phase 3 address-derivation draft manifest",
  "oneOf": [
    {
      "$ref": "#/$defs/historicalDraft"
    },
    {
      "$ref": "#/$defs/nativeSharednativeAddressDerivationDraft"
    }
  ],
  "$defs": {
    "address": {
      "type": "string",
      "pattern": "^0x[0-9a-fA-F]{40}$"
    },
    "nonzeroAddress": {
      "allOf": [
        {
          "$ref": "#/$defs/address"
        },
        {
          "not": {
            "const": "0x0000000000000000000000000000000000000000"
          }
        }
      ]
    },
    "nullableAddress": {
      "type": [
        "null",
        "string"
      ],
      "pattern": "^0x[0-9a-fA-F]{40}$"
    },
    "bytes32": {
      "type": "string",
      "pattern": "^0x[0-9a-fA-F]{64}$"
    },
    "nullableBytes32": {
      "type": [
        "null",
        "string"
      ],
      "pattern": "^0x[0-9a-fA-F]{64}$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "applicantSalt": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "$ref": "#/$defs/bytes32"
        }
      ]
    },
    "tokenTarget": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "targetId",
        "targetIndex",
        "componentKind",
        "sourcePath",
        "contractName",
        "applicantSalt",
        "effectiveSalt",
        "address",
        "constructor",
        "initializerCalldata",
        "deploymentValue",
        "initializerValue",
        "creationBytecodeHash",
        "runtimeTemplateCodeHash",
        "runtimeCodeHash",
        "artifactSha256",
        "libraries"
      ],
      "properties": {
        "targetId": {
          "const": "token"
        },
        "targetIndex": {
          "const": 0
        },
        "componentKind": {
          "const": "token"
        },
        "sourcePath": {
          "const": "packages/contracts/src/launch/HKMNToken.sol"
        },
        "contractName": {
          "const": "HKMNToken"
        },
        "applicantSalt": {
          "type": "null"
        },
        "effectiveSalt": {
          "type": "null"
        },
        "address": {
          "type": "null"
        },
        "constructor": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "issuanceAuthority",
            "expectedUsdg",
            "decimals",
            "launchSqrtPriceX96"
